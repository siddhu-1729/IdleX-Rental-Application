# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Database
MONGO_URI=mongodb://127.0.0.1:27017/idlex

# Auth / JWT
JWT_ACCESS_SECRET=dev_access_secret_idlex
JWT_REFRESH_SECRET=dev_refresh_secret_idlex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP / SMS (Twilio) - empty = dev mode (OTP logged to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# File storage (local disk by default; swap for S3/Cloudinary in production)
UPLOAD_DIR=uploads

# Payments (Razorpay example - swap for Stripe if needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@idlex.com
ADMIN_PASSWORD=admin12345
