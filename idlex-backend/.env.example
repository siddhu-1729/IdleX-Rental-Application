# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/idlex

# Auth / JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP / SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (SMTP) - used to deliver email OTPs. If unset, OTPs are logged to the console in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IdleX <no-reply@idlex.app>

# File storage (local disk by default; swap for S3/Cloudinary in production)
UPLOAD_DIR=uploads

# Payments (Razorpay example - swap for Stripe if needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@idlex.com
ADMIN_PASSWORD=admin12345
